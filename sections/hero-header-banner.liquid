    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary button link"
    },
    {
      "type": "checkbox",
      "id": "show_primary_arrow",
      "label": "Show arrow in primary button",
      "default": true
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "primary_btn_text_color",
      "label": "Primary button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_btn_border",
      "label": "Primary button border",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
