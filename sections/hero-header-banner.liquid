<!--hero-header-banner.liquid-->
<style>
  #chisel-glow-banner-{{ section.id }} {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;

    --left-bg: {{ section.settings.left_bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --highlight-color: {{ section.settings.highlight_color }};
    --text-color: {{ section.settings.text_color }};

    --primary-btn-bg: {{ section.settings.primary_btn_bg }};
    --primary-btn-text: {{ section.settings.primary_btn_text_color }};
    --primary-btn-border: {{ section.settings.primary_btn_border }};

    --secondary-btn-bg: {{ section.settings.secondary_btn_bg }};
    --secondary-btn-text: {{ section.settings.secondary_btn_text_color }};
    --secondary-btn-border: {{ section.settings.secondary_btn_border }};
  }

  #chisel-glow-banner-{{ section.id }} .chisel-glow-wrap {
    min-height: {{ section.settings.banner_height_desktop }}px;
  }

  #chisel-glow-banner-{{ section.id }} .banner-image {
    min-height: {{ section.settings.banner_height_desktop }}px;
  }

  #chisel-glow-banner-{{ section.id }} .sticker-wrap {
    left: {{ section.settings.sticker_left_desktop }}%;
    top: {{ section.settings.sticker_top_desktop }}%;
    width: {{ section.settings.sticker_size_desktop }}px;
    height: {{ section.settings.sticker_size_desktop }}px;
  }

  @media screen and (max-width: 767px) {
    #chisel-glow-banner-{{ section.id }} {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #chisel-glow-banner-{{ section.id }} .chisel-glow-wrap {
      min-height: auto;
    }

    #chisel-glow-banner-{{ section.id }} .banner-image {
      min-height: {{ section.settings.banner_height_mobile }}px;
    }

    #chisel-glow-banner-{{ section.id }} .sticker-wrap {
      left: {{ section.settings.sticker_left_mobile }}%;
      top: {{ section.settings.sticker_top_mobile }}%;
      width: {{ section.settings.sticker_size_mobile }}px;
      height: {{ section.settings.sticker_size_mobile }}px;
    }
  }
</style>
<section
  id="chisel-glow-banner-{{ section.id }}"
  class="chisel-glow-banner"
>
  <div class="chisel-glow-wrap relative grid grid-cols-1 overflow-hidden md:grid-cols-[42%_58%]">
    <div class="order-2 z-[2] flex flex-col justify-center bg-[var(--left-bg)] px-5 py-[42px] md:order-1 md:px-11 md:py-[72px] gap-[24px]">
      {% if section.settings.eyebrow != blank %}
        <div class="flex items-center gap-3 text-[10px] font-medium uppercase tracking-[2px] text-[var(--highlight-color)] before:block before:h-px before:w-[18px] before:bg-[var(--highlight-color)]">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank or section.settings.highlight_text != blank %}
        <h2 class="m-0 max-w-[400px] text-[32px] font-bold uppercase !leading-normal text-[var(--heading-color)] md:text-[40px]">
          {% if section.settings.highlight_text != blank %}
            <span class="text-[var(--highlight-color)]">
              {{ section.settings.highlight_text }} </span
            ><br>
          {% endif %}

          {% if section.settings.heading != blank %}
            {{ section.settings.heading }}
          {% endif %}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class=" max-w-[350px] text-[12px] uppercase leading-[1.6] tracking-[2px] text-[var(--text-color)]  md:text-[13px] md:tracking-[3px]">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="mt-[30px] flex flex-wrap items-center gap-[10px] md:mt-[50px]">
        {% if section.settings.primary_btn_text != blank %}
          <a
            href="{{ section.settings.primary_btn_link | default: '#' }}"
            class="inline-flex min-h-[46px] min-w-[145px] items-center justify-center gap-3 rounded-full border text-[13px] font-semibold no-underline transition-all duration-300 hover:-translate-y-0.5 hover:opacity-90 md:min-h-[50px] md:min-w-[190px] md:text-[14px]"
            style="background: var(--primary-btn-bg); color: var(--primary-btn-text); border-color: var(--primary-btn-border);"
          >
            {{ section.settings.primary_btn_text }}

            {% if section.settings.show_primary_arrow %}
              <span aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="15" viewBox="0 0 24 15" fill="none">
                  <path d="M1 6.36395C0.447715 6.36395 0 6.81167 0 7.36395C0 7.91624 0.447715 8.36395 1 8.36395V7.36395V6.36395ZM23.2071 8.07106C23.5976 7.68054 23.5976 7.04737 23.2071 6.65685L16.8431 0.292885C16.4526 -0.0976396 15.8195 -0.0976396 15.4289 0.292885C15.0384 0.683409 15.0384 1.31657 15.4289 1.7071L21.0858 7.36395L15.4289 13.0208C15.0384 13.4113 15.0384 14.0445 15.4289 14.435C15.8195 14.8255 16.4526 14.8255 16.8431 14.435L23.2071 8.07106ZM1 7.36395V8.36395H22.5V7.36395V6.36395H1V7.36395Z" fill="white"/>
                </svg>
              </span>
            {% endif %}
          </a>
        {% endif %}

        {% if section.settings.secondary_btn_text != blank %}
          <a
            href="{{ section.settings.secondary_btn_link | default: '#' }}"
            class="inline-flex min-h-[46px] min-w-[145px] items-center justify-center rounded-full border text-[13px] font-semibold no-underline transition-all duration-300 hover:-translate-y-0.5 hover:opacity-90 md:min-h-[50px] md:min-w-[190px] md:text-[14px]"
            style="background: var(--secondary-btn-bg); color: var(--secondary-btn-text); border-color: var(--secondary-btn-border);"
          >
            {{ section.settings.secondary_btn_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="banner-image order-1 relative md:order-2">
      {% if section.settings.desktop_image != blank %}
        <picture class="block h-full w-full">
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 767px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
            >
          {% endif %}

          <img
            src="{{ section.settings.desktop_image | image_url: width: 1800 }}"
            alt="{{ section.settings.desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.desktop_image.width }}"
            height="{{ section.settings.desktop_image.height }}"
            class="block h-full w-full object-cover"
          >
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'block h-full w-full object-cover' }}
      {% endif %}
    </div>

    {% if section.settings.show_sticker %}
      <div class="sticker-wrap pointer-events-none absolute z-[5] -translate-x-1/2 -translate-y-1/2">
        {% if section.settings.sticker_image != blank %}
          <img
            src="{{ section.settings.sticker_image | image_url: width: 400 }}"
            alt="{{ section.settings.sticker_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.sticker_image.width }}"
            height="{{ section.settings.sticker_image.height }}"
            class="block h-full w-full object-contain"
          >
        {% else %}
          <div class="flex h-full w-full items-center justify-center rounded-full bg-[var(--highlight-color)] p-4 text-center text-[14px] font-bold uppercase leading-[1.2] text-white">
            {{ section.settings.sticker_text }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "hero header banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Pink heading text",
      "default": "CHISEL & GLOW:"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "LIFT SCULPT AND SHINE EFFORTLESSLY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "FOUR NEW SHADES OF OUR AWARD-WINNING LIP WHIPS"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop banner image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile banner image"
    },
    {
      "type": "header",
      "content": "Sticker"
    },
    {
      "type": "checkbox",
      "id": "show_sticker",
